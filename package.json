{
  "name": "moment-lark",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "npm run prompts:check && next build",
    "prompts:generate": "node --import tsx scripts/prompts.mts --write",
    "prompts:check": "node --import tsx scripts/prompts.mts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts server/tests/*.test.ts",
    "dev:api": "npm run db:migrate:local && wrangler dev --config wrangler.local.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "test:api": "node --import tsx --test server/tests/*.test.ts",
    "check:deploy": "wrangler deploy --dry-run --config wrangler.jsonc",
    "check:deploy:dev": "wrangler deploy --dry-run --config wrangler.jsonc --env dev",
    "deploy:production": "wrangler deploy --config wrangler.jsonc",
    "deploy:dev": "wrangler deploy --config wrangler.jsonc --env dev"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@mlc-ai/web-llm": "0.2.89",
    "@remotion/media": "4.0.545",
    "@remotion/player": "4.0.545",
    "@remotion/web-renderer": "4.0.545",
    "fflate": "^0.8.3",
    "hono": "^4.13.19",
    "mediabunny": "1.66.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.545",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "miniflare": "5.20261119.0-beta",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "^5",
    "wrangler": "4.166.0"
  }
}
